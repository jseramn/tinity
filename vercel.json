{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm --dir landing build",
  "outputDirectory": "landing/dist",
  "installCommand": "pnpm --dir landing install --frozen-lockfile --ignore-workspace",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Vary", "value": "Accept, Accept-Encoding" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Vary", "value": "Accept, Accept-Encoding" }]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        { "type": "header", "key": "accept", "value": "(.*)text/markdown(.*)" }
      ],
      "destination": "/index.md"
    }
  ]
}
