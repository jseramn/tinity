{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm --dir landing build",
  "outputDirectory": "landing/dist",
  "installCommand": "echo 'landing/node_modules already present; do not install.'",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
