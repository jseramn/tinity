+  width: min(100%, 720px);
+  height: auto;
+  display: block;
+  margin: 0 auto;
+}
+
+.hub-spoke {
+  stroke-dasharray: 5 5;
+}
+
+@media (prefers-reduced-motion: no-preference) {
+  .hub-spoke {
+    animation: dashmove 0.8s linear infinite;
+  }
+}
+
+@keyframes dashmove {
+  to {
+    stroke-dashoffset: -10;
+  }
+}
+
+.hub-node[data-status="live"] circle {
+  stroke: var(--accent);
+  filter: drop-shadow(0 0 6px var(--accent-ring));
+}
+
+.hub-stack {
+  display: none;
+  grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
+  gap: 8px;
+  list-style: none;
+  padding: 0;
+  margin: 24px 0 0;
+}
+
+.hub-stack li {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  color: var(--text-dim);
+  font-family: var(--font-mono);
+  font-size: 12px;
+}
+
+.hub-stack img {
+  filter: grayscale(1);
+  opacity: 0.55;
+}
+
+.slice-grid,
+.change-grid,
+.community-grid {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 16px;
+  padding: 0;
+  margin: 32px 0;
+  list-style: none;
+}
+
+.slice-card,
+.change-card,
+.community-grid li {
+  padding: 20px;
