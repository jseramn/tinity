+  border-radius: 8px;
+  background: var(--surface);
+}
+
+.slice-title,
+.change-title {
+  margin: 8px 0;
+  font-size: 20px;
+  font-weight: 500;
+}
+
+.slice-dek,
+.community-grid p,
+.change-card ul,
+.faq-item p,
+.win-body {
+  color: var(--text-muted);
+}
+
+.badge {
+  display: inline-flex;
+  align-items: center;
+  padding: 4px 8px;
+  border-radius: 9999px;
+  font-family: var(--font-mono);
+  font-size: 11px;
+  letter-spacing: 0.08em;
+}
+
+.badge--shipped {
+  background: var(--accent);
+  color: var(--on-accent);
+}
+
+.badge--in-design {
+  border: 1px solid var(--accent);
+  color: var(--accent);
+}
+
+.badge--next,
+.badge--later {
+  color: var(--text-dim);
+  border: 1px solid var(--border);
+}
+
+.community-grid a {
+  color: var(--text);
+  text-decoration: none;
+}
+
+.community-grid li[data-status="coming"] a {
+  color: var(--text-dim);
+}
+
+.faq-list {
+  margin-top: 32px;
+}
+
+.faq-item {
+  border-bottom: 1px solid var(--hairline);
+}
+
+.faq-item summary {
+  cursor: pointer;
+  padding: 16px 0;
+  font-size: 18px;
+}
+
+.faq-item p {
+  margin: 0 0 16px;
+}
+
+.site-footer {
+  padding: 32px 24px 48px;
+  border-top: 1px solid var(--hairline);
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+}
+
+.site-footer-meta {
+  margin: 0;
+  font-family: var(--font-mono);
+  font-size: 11px;
+  letter-spacing: 0.08em;
+  color: var(--text-dim);
+}
+
+.win {
+  width: min(720px, calc(100vw - 32px));
+  max-height: 80vh;
+  padding: 0;
+  border: 1px solid var(--border);
+  border-radius: 12px;
+  background: var(--surface);
+  color: var(--text);
+  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28), 0 0 0 1px var(--border);
+}
+
+.win::backdrop {
+  background: rgba(5, 5, 5, 0.6);
+}
+
+@media (prefers-reduced-motion: no-preference) {
+  .win[open] {
+    animation: win-in 180ms var(--ease);
+  }
+}
+
+@keyframes win-in {
+  from {
+    opacity: 0;
+    transform: translateY(4px);
+  }
+}
+
+.win-bar {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 12px 16px;
+  border-bottom: 1px solid var(--hairline);
+}
+
+.win-title {
+  margin: 0;
+  font-size: 16px;
+  font-weight: 500;
+}
+
+.win-body {
+  padding: 16px 20px 24px;
+  overflow: auto;
+}
+
+.agent-surface {
+  min-height: 100svh;
+}
+
+.agent-toolbar {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+  padding: 16px 24px;
+  border-bottom: 1px solid var(--hairline);
+}
+
+.agent-md {
+  margin: 0;
+  padding: 24px;
+  white-space: pre-wrap;
+  font-family: var(--font-mono);
+  font-size: 13px;
+  line-height: 1.55;
+  color: var(--text);
+}
+
+@media (max-width: 768px) {
+  .nav {
+    padding: 0 16px;
+  }
+
+  .nav-desktop {
+    display: none;
+  }
+
+  .nav-menu {
+    display: inline-flex;
+  }
+
+  .hero-title {
+    font-size: 32px;
+  }
+
+  .section {
+    padding: 64px 16px;
+  }
+
+  .slice-grid,
+  .change-grid,
+  .community-grid {
+    grid-template-columns: 1fr;
+  }
+
+  .hub-ring {
+    display: none;
+  }
+
+  .hub-stack {
+    display: grid;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .hub-spoke {
+    animation: none;
+    stroke-dasharray: none;
+  }
+
+  .win[open] {
+    animation: none;
+  }
+
+  .lockup-i::after,
+  .surface-switch-btn,
+  .btn-ghost {
+    transition: none;
+  }
+}
